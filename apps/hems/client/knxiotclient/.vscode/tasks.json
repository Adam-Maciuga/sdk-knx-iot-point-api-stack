{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint Project",
            "type": "shell",
            "command": "${workspaceFolder}/script/lint.bat",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$pylint"]
        }
    ]
}