<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
       <OutputType>Exe</OutputType>
       <TargetFramework>net10.0</TargetFramework>
       <ImplicitUsings>enable</ImplicitUsings>
       <Nullable>enable</Nullable>

       <!-- Single-file publishing settings -->
       <PublishSingleFile>true</PublishSingleFile>
       <SelfContained>true</SelfContained>
       <RuntimeIdentifier>win-x64</RuntimeIdentifier>

       <!-- Optional: Trim unused code to reduce file size -->
       <PublishTrimmed>true</PublishTrimmed>

       <!-- Optional: Enable ReadyToRun for faster startup -->
       <PublishReadyToRun>true</PublishReadyToRun>

       <!-- Optional: Embed native libraries -->
       <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
       <PackageReference Include="MeaMod.DNS" Version="1.0.70" />
    </ItemGroup>

</Project>
