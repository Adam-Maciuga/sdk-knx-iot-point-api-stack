<?xml version="1.0" encoding="utf-8"?>
<!--
  EITT's own JSON<->CBOR key map for the KNX IoT Point API, supplied by the
  user 2026-07-24 from the EITT installation. This is the AUTHORITATIVE
  source for resource_schema.py: EITT resolves a telegram's human-readable
  JSON <Content> to wire CBOR using exactly these tables, so any key we
  need is here rather than something to reverse-engineer from traces.

  Structure:
    - The Default="yes" map applies to ANY path that has no path-specific
      map of its own. resource_schema.py mirrors this as _DEFAULT_SCHEMA.
    - Path-specific maps override it for that path. Note "auth/at" and
      "auth/at.*" are DIFFERENT maps (the collection vs. an entry's OSCORE
      key configuration), and ".well-known/knx/spake" has its own.
    - Some JSON names deliberately share a CBOR key within a map (e.g. in
      PAPI_RKM_OSCORE: ms/kid/sub all = 2, hkdf/aud = 3, osc/alg = 4,
      nbf/salt = 5) because they occur in mutually exclusive contexts.
      Encoding is therefore JSON-name -> CBOR key (unambiguous); decoding
      back is ambiguous for those, so prefer the name the XML used.
-->
<EITT_KnxPointAPIResourceKeyMaps xmlns="http://knx.org/xml/eitt/4.3" Version="8" DateOfVersion="2024/10/29" MinEITTVersion="4.4.002" Comment="">
  <Header>
    <KNXStandard>KNX v3.0.3</KNXStandard>
  </Header>
  <History>
    <Hitem Version="1" Date="2023/06/26" Who="AE" Change="Initial version"/>
    <Hitem Version="2" Date="2023/08/28" Who="AE" Change="different maps for auth/at.* and .well-known/knx/spake"/>
    <Hitem Version="3" Date="2023/10/10" Who="AE" Change="auth/at update"/>
    <Hitem Version="4" Date="2023/10/19" Who="AE" Change="auth/at update contextid"/>
    <Hitem Version="5" Date="2024/02/07" Who="AE" Change="CBOR key value changed to 14 for 'at'"/>
    <Hitem Version="6" Date="2024/05/31" Who="AE" Change="CBOR key value 'salt' added to 'auth/at'"/>
    <Hitem Version="7" Date="2024/05/31" Who="SMV" Change="CBOR key value 'a','c','seqCntr', 'knxClassicObj' added"/>
    <Hitem Version="8" Date="2024/10/29" Who="SMV" Change="CBOR key value 'pw' added"/>
  </History>
  <PointAPIResourceKeyMaps>
