<?xml version="1.0" encoding="utf-8"?>
<EITT_KnxCommentCommandDescriptions xmlns="http://knx.org/xml/eitt/4.2" Version="2" DateOfVersion="2025/06/16" MinEITTVersion="4.4.070">

	<Categories>
		<Category Name="Common" Index="0"/>
		<Category Name="Timing" Index="1"/>
		<Category Name="Interface" Index="2"/>

		<Category Name="Sequence" Index="3"/>

		<Category Name="Security" Index="4"/>
		<Category Name="Point API" Index="5"/>
		<!-- <Category Name="3rd Party API" Index="6"/> -->
	</Categories>

	<CommentCommands>
		<!-- ======================= COMMON ======================= -->

		<!-- Display comment in toolbar -->
		<CommentCommand Name="" Command="@" Category="0" Body="y" Param="n" Format="@&lt;text to show&gt;" DescrShort="Display comment in toolbar" DescrLong=""/>
		<!-- Display comment in toolbar and beep -->
		<CommentCommand Name="" Command="@!" Category="0" Body="y" Param="n" Format="@!&lt;text to show&gt;" DescrShort="Display comment in toolbar and beep" DescrLong=""/>

		<!-- Display comment in toolbar and suspend evaluation -->
		<CommentCommand Name="" Command="@@" Category="0" Body="y" Param="n" Format="@@&lt;text to show&gt;" DescrShort="Display comment in toolbar and suspend evaluation" DescrLong="When the tool encounters this command, sequence execution stops and comment is displayed in a message box, sequence execution is resumed when message box is closed"/>

		<!-- Display comment in toolbar, suspend evaluation and beep -->
		<CommentCommand Name="" Command="@@!" Category="0" Body="y" Param="n" Format="@@!&lt;text to show&gt;" DescrShort="Display comment in toolbar suspend evaluation and beep" DescrLong=""/>

		<!-- Display comment in toolbar, suspend evaluation and beep -->
		<CommentCommand Name="" Command="@@+" Category="0" Body="y" Param="n" Format="@@+&lt;text to show&gt;" DescrShort="Display comment in toolbar, suspend evaluation, display a dialog and set result" DescrLong="Suspends the telegram sequence evaluation and allows the user to document a BDUT error via a dialog. If the button ‘BDUT error’ is pressed, an appropriate hint is added to the tracebuffer (e.g. to document incorrect behaviour of an actuator in spite of correct reception of a telegram)"/>

		<!-- Append to trace buffer -->
		<CommentCommand Name="" Command="@[t" Category="0" Body="y" Param="n"  Format="@[t&lt;text to append&gt;" DescrShort="Append to trace buffer" DescrLong="When the tool encounters this command, the comment is appended to the Trace Buffer"/>

		<!-- Avoids red telegrams in Trace Buffer -->
		<CommentCommand Name="" Command="@AP" Category="0" Body="n" Param="y" Format="@AP&quot;&lt;on/off&gt;&quot;" DescrShort="Avoids red telegrams in Trace Buffer" DescrLong="The command @AP &quot;on&quot; (means &quot;Automatic Pass On&quot;) prevents red AF marks for incorrect telegrams. They are automatically AP (&quot;Automatic Passed&quot;) marked in the trace buffer. Nevertheless, the red arrows up/down for browsing to the wrong telegrams are still activated. The @AP commands are also transferred to the trace buffer.">
			<CommandParameter Pos="0" Name="Switch on/off" Values="on#off" Default="&lt;on/off&gt;" Description="Switch AP on or off"/>
		</CommentCommand> 

		<!-- ======================= TIMING ======================= -->

		<!-- Display in toolbar and wait timespan -->
		<CommentCommand Name="Wait" Command="@[w" Category="1" Body="y" Param="y" Format="@[w&quot;&lt;wait time&gt;&quot;&lt;Text to show in toolbar&gt;" DescrShort="Display in toolbar and wait timespan" DescrLong="When the tool encounters this command, execution is delayed for the specified time, an optional comment is displayed in the Toolbar (timer resolution 1s)">
			<CommandParameter Pos="0" Name="Wait time" Default="00:00:05" Format="Time" Description="Wait timespan [sec]"/>
		</CommentCommand> 

		<!-- Display in toolbar and wait timespan -->
		<!-- <CommentCommand Name="Wait" Command="@[w" Category="1" Body="y" Param="y" Format="@[w&quot;&lt;wait time&gt;&quot;&lt;Text to show in toolbar&gt;" DescrShort="Display in toolbar and wait timespan" DescrLong="When the tool encounters this command, execution is delayed for the specified time, an optional comment is displayed in the Toolbar (timer resolution 0.1s)">
			<CommandParameter Pos="0" Name="Wait time" Default="00:00:00.2" Format="Time" Description="Wait timespan [sec]"/>
		</CommentCommand>  -->

		<!-- Display in toolbar and wait timespan -->
		<CommentCommand Name="Wait" Command="@@[w" Category="1" Body="y" Param="y" Format="@@[w&quot;&lt;wait time&gt;&quot;&lt;Text to show in toolbar&gt;" DescrShort="Display in toolbar and wait timespan" DescrLong="When the tool encounters this command, execution is delayed for the specified time (timer resolution 1s). The remaining time to wait and an optional comment is displayed in a dialog.">
			<CommandParameter Pos="0" Name="Wait time" Default="00:00:05" Format="Time" Description="Wait timespan [sec]"/>
		</CommentCommand> 

		<!-- Display in toolbar and wait timespan -->
		<!-- <CommentCommand Name="Wait" Command="@@[w" Category="1" Body="y" Param="y" Format="@[w&quot;&lt;wait time&gt;&quot;&lt;Text to show in toolbar&gt;" DescrShort="Display in toolbar and wait timespan" DescrLong="When the tool encounters this command, execution is delayed for the specified time (timer resolution 0.1s). The remaining time to wait and an optional comment is displayed in a dialog.">
			<CommandParameter Pos="0" Name="Wait time" Default="00:00:05.2" Format="Time" Description="Wait timespan [sec]"/>
		</CommentCommand> -->

		<!-- ======================= INTERFACE ======================= -->
		
		<!-- Activate connection in given layer -->
		<CommentCommand Name="" Command="@if+" Category="2" Body="n" Param="y" Format="@if+&quot;&lt;layer&gt;;&lt;connection name&gt;&quot;" DescrShort="Activate connection in given layer" DescrLong="Layer:&#9;&#9;Layer to activate: ll, bm, rw, tl#Connection name: Nickname of the connection#Type:&#9;&#9;&lt;empty&gt; or direct (EITT directly sends layer switch services without closing and re-openening the connection to the interface)">
			<CommandParameter Pos="0" Name="Layer" Values="ll#bm#rw#tl" Default="&lt;ll/bm/rw/tl&gt;" Description="Layer to activate: ll, bm, rw, tl"/>
			<CommandParameter Pos="1" Name="Connection name" Default="&lt;connection nickname&gt;" Format="nick" Description="Name of connection to activate"/>
			<CommandParameter Pos="2" Name="Layer switch mode" Default="&lt;empty&gt; or direct " Description="direct: EITT directly sends layer switch services"/>
		</CommentCommand> 
		
		<!-- Deactivate connection -->
		<CommentCommand Name="" Command="@if-" Category="2" Body="n" Param="y" Format="@if-&quot;&lt;connection name&gt;&quot;" DescrShort="Deactivate connection" DescrLong="Connection Name: Nickname of the connection">
			<CommandParameter Pos="0" Name="Connection Name" Default="&lt;connection nickname&gt;" Format="nick" Description="Name of connection to deactivate"/>
		</CommentCommand> 
		
		<!-- ======================= SEQUENCE ======================= -->
		
		<!-- Call telegram sequence -->
		<CommentCommand Name="" Command="@#" Category="3" Body="n" Param="y" Format="@#&quot;Telegram sequence name&quot;" DescrShort="Call telegram sequence" DescrLong="Call telegram sequence">
			<CommandParameter Pos="0" Name="Sequence Name" Default="&lt;sequence name&gt;" Format="seq" Description="Name of telegam sequence"/>
		</CommentCommand> 
		
		<!-- Call telegram sequence -->
		<CommentCommand Name="" Command="@##" Category="3" Body="n" Param="y" Format="@#&quot;Telegram sequence name&quot;" DescrShort="Call conformance test telegram sequence" DescrLong="Call conformance test telegram sequence">
			<CommandParameter Pos="0" Name="Sequence Name" Default="&lt;sequence name&gt;" Format="seq" Description="Name of conformance test telegam sequence"/>
		</CommentCommand> 

		<!-- Parallel call telegram sequence -->
		<CommentCommand Name="" Command="@&gt;" Category="3" Body="n" Param="y" Format="@&gt;&quot;Telegram sequence name;&lt;loops&gt;&quot;" DescrShort="Parallel call of telegram sequence" DescrLong="Parallel call of telegram sequence">
			<CommandParameter Pos="0" Name="Sequence Name" Default="&lt;sequence name&gt;" Format="seq" Description="Name of telegam sequence"/>
			<CommandParameter Pos="1" Name="Loops" Values="unlimited" Default="&lt;loop number / unlimited&gt;" Description="Number of loops or &quot;unlimited&quot;"/>
		</CommentCommand> 
	
		<!-- Parallel call telegram sequence -->
		<CommentCommand Name="" Command="@&gt;w" Category="3" Body="n" Param="y" Format="@&gt;&quot;Telegram sequence name;&lt;loops&gt;&quot;" DescrShort="Parallel call of telegram sequence and wait for finish" DescrLong="Parallel call of telegram sequence. The calling sequence waits for the called sequence running in parallel before the calling sequence is ended.">
			<CommandParameter Pos="0" Name="Sequence Name" Default="&lt;sequence name&gt;" Format="seq" Description="Name of telegam sequence"/>
			<CommandParameter Pos="1" Name="Loops" Values="unlimited" Default="&lt;loop number / unlimited&gt;" Description="Number of loops or &quot;unlimited&quot;"/>
		</CommentCommand> 

		<!-- Stop parallel sequence call -->
		<CommentCommand Name="" Command="@&lt;" Category="3" Body="n" Param="y" Format="@&lt;&quot;Telegram sequence name&quot;" DescrShort="Stop parallel sequence call" DescrLong="Stop parallel sequence call">
			<CommandParameter Pos="0" Name="Sequence Name" Default="&lt;sequence name&gt;" Format="seq" Description="Name of telegam sequence"/>
		</CommentCommand> 
		
		<!-- ======================= SECURITY ======================= -->

		<!-- Clear security challenge table -->
		<CommentCommand Name="" Command="@@[rc" Category="4" Body="n" Param="n" Format="@@[rc" DescrShort="Clear security challenge table" DescrLong="This command can be used to clear the internal challenge table of EITT. This command is useful after S-A_Sync negative tests to prevent EITT from using wrong challenges"/>

		<!-- Reset the values in the security sequence number table -->
		<CommentCommand Name="" Command="@@[rn" Category="4" Body="n" Param="n" Format="@@[rn" DescrShort="Reset the values in the security sequence number table" DescrLong=""/>

		<!-- Change security key -->
		<CommentCommand Name="" Command="@@[sk" Category="4" Body="n" Param="y" Format="@@[sk&quot;&lt;type&gt;;&lt;address&gt;;&lt;serial/domain&gt;;&lt;direction&gt;;&lt;key&gt;&quot;" DescrShort="Change security key" DescrLong="Type:&#9;&#9;tool / physical / physical+serial / physical+domain / group / group+serial / group+domain / dh_temporary#Address:&#9;destination address#Serial/domain:&#9;serial number or domain address#Direction:&#9;IN/OUT#Key:&#9;&#9;new security key##Example: @@[sk&quot;physical+domain;1.1.11;1234567890AB;IN/OUT,55555555555555555555555555555520”#The example command sets 55555555555555555555555555555520 as new value for the security key to encrypt telegrams for the specified device.">
			<CommandParameter Pos="0" Name="Type" Default="tool" Values="tool#physical#physical+serial#physical+domain#group#group+serial#group+domain#dh_temporary" Description="One of tool/physical/physical+serial/physical+domain/group/group+serial/group+domain/dh_temporary"/>
			<CommandParameter Pos="1" Name="Address" Default="&lt;destination address&gt;" Description="Destination address"/>
			<CommandParameter Pos="2" Name="Serial/domain" Default="&lt;serial or domain&gt;" Description="Serial number or domain address"/>
			<CommandParameter Pos="3" Name="Direction" Default="in" Values="in#out" Description="Communication way, IN or OUT"/>
			<CommandParameter Pos="4" Name="Security key" Default="&lt;security key&gt;" Description="New security key"/>
			<CommandParameter Pos="5" Name="Source address" Default="&lt;source address&gt;" Description="Source Address"/>
		</CommentCommand> 
	
		<!-- Change security sequence number -->
		<CommentCommand Name="" Command="@@[sn" Category="4" Body="n" Param="y" Format="@@[sn&quot;&lt;type&gt;;&lt;address&gt;;&lt;serial/domain&gt;;&lt;direction&gt;;&lt;connection&gt;;&lt;sequence number&gt;&quot;" DescrShort="Change security sequence number" DescrLong="Type:&#9;&#9;tool / physical / physical+serial / physical+domain#Address:&#9;individual address#Serial/domain:&#9;serial number or domain address#Direction:&#9;IN/OUT#Connection:&#9;connection nickname#Sequence number: &lt;new sequence number&gt;##Example: @@[sn&quot;physical+serial;3.3.18;11;111111111111;IN;SER;1235&quot;#The example command sets 1235 as new value for the next security sequence number for the device 3.3.18 (with RF Serial Number 111111111111) via the connection 'SER'.">
			<CommandParameter Pos="0" Name="Type" Default="tool" Values="tool#physical#physical+serial#physical+domain" Description="One of tool/physical/physical+serial/physical+domain"/>
			<CommandParameter Pos="1" Name="Address" Default="&lt;individual address&gt;" Description="Individual address"/>
			<CommandParameter Pos="2" Name="Serial/domain" Default="&lt;serial or domain&gt;" Description="Serial number or domain address"/>
			<CommandParameter Pos="3" Name="Direction" Default="in" Values="in#out" Description="Communication way, IN or OUT"/>
			<CommandParameter Pos="4" Name="Connection" Default="&lt;connection name&gt;" Description="Connection nickname"/>
			<CommandParameter Pos="5" Name="Sequence number" Default="&lt;new sequence number&gt;" Description="New sequence number in table"/>
		</CommentCommand> 
	
		<!-- Import security configuration table -->
		<CommentCommand Name="" Command="@@[import" Category="4" Body="n" Param="y" Format="@@[import&quot;secconftable;clear=&lt;yes/no&gt;;&quot;dir=&lt;directory&gt;;file=&lt;file name&gt;" DescrShort="Import security configuration table" DescrLong="Table: secconftable#Command 1: clear=yes/no#Command 2: dir=&lt;directory location&gt;#Command 3: file=&lt;Namof CSV file to import&gt;">
			<CommandParameter Pos="0" Name="Table" Default="secconftable" Description="Table type ('secconftable' only)"/>
			<CommandParameter Pos="1" Name="Command 1" Default="clear=&lt;yes/no&gt;" Description="Clear or dont't clear table before import"/>
			<CommandParameter Pos="2" Name="Command 2" Default="dir=&lt;directory path&gt;" Description="Directory location of security configuration table"/>
			<CommandParameter Pos="3" Name="Command 3" Default="file=&lt;file name&gt;" Description="Name of security configuration table CSV file to import"/>
		</CommentCommand> 
		
		<!-- ======================= POINT API ======================= -->
		
		<!-- Configure CoAP security context -->
		<CommentCommand Name="" Command="@@[pahctx" Category="5" Body="n" Param="y" Format="@@[pahctx&quot;&lt;context name&gt;;mastersecret=&lt;mastersecret&gt;;senderid=&lt;senderid&gt;;recipientid=&lt;recipientid&gt;;contextid=&lt;contextid&gt;;accesstoken=&lt;accesstoken&gt;;salt=&lt;salt&gt;;txseq=&lt;txseq&gt;;rxseq=&lt;rxseq&gt;;remove=&lt;true/false&gt;;activate=true;destination=&lt;destination device&gt;;updatesession=true" DescrShort="Configure CoAP security context" DescrLong="Context name:&#9;&#9;Name of CoAP security context to configure#mastersecret=&lt;&gt;&#9;master secret as hex value#recipientid=&lt;&gt;&#9;&#9;recipient ID as hex value#senderid=&lt;&gt;&#9;&#9;sender ID as hex value#contextid=&lt;&gt;&#9;&#9;context ID as hex value#accesstoken=&lt;&gt;&#9;access token as hex value#salt=&lt;&gt;&#9;&#9;&#9;salt as hex value#txseq=&lt;&gt;&#9;&#9;next TX sequence number as integer#rxseq=&lt;&gt;&#9;&#9;expected next RX sequence number as integer#remove=true&#9;&#9;remove security context#activate=&lt;&gt;&#9;&#9;activates security context for given destination device#updatesession=&lt;&gt;&#9;updates security context for given destination device#destination=&lt;&gt;&#9;&#9;Name of destination device">
			<CommandParameter Pos="0" Name="Context name" Default="&lt;CoAP security context&gt;" Description="Name of CoAP security context"/>
			<CommandParameter Pos="1" Name="Command 1" ShowOptions="y" IsOption= "y" Default="mastersecret=&lt;master secret&gt;" Description="Set master secret"/>
			<CommandParameter Pos="2" Name="Command 2" ShowOptions="y" IsOption= "y" Default="recipientid=&lt;recipient ID&gt;" Description="Set recipient ID"/>
			<CommandParameter Pos="3" Name="Command 3" ShowOptions="y" IsOption= "y" Default="senderid=&lt;sender ID&gt;" Description="Set sender ID"/>
			<CommandParameter Pos="4" Name="Command 4" ShowOptions="y" IsOption= "y" Default="contextid=&lt;context ID&gt;" Description="Set context ID"/>
			<CommandParameter Pos="5" Name="Command 5" ShowOptions="y" IsOption= "y" Default="accesstoken=&lt;access token&gt;" Description="Set access token"/>
			<CommandParameter Pos="6" Name="Command 6" ShowOptions="y" IsOption= "y" Default="salt=&lt;salt&gt;" Description="Set salt"/>
			<CommandParameter Pos="7" Name="Command 7" ShowOptions="y" IsOption= "y" Default="txseq=&lt;tx sequence number&gt;" Description="Change TX sequence number"/>
			<CommandParameter Pos="8" Name="Command 8" ShowOptions="y" IsOption= "y" Default="rxseq=&lt;rx sequence number&gt;" Description="Change RX sequence number"/>
			<CommandParameter Pos="9" Name="Command 9" ShowOptions="y" IsOption= "y" Default="remove=&lt;true/false&gt;" Description="Remove CoAP security context (true or false)"/>
			<CommandParameter Pos="10" Name="Command 10" ShowOptions="y" IsOption= "y" Default="activate=true" Description="Activates context for destination device (true or false)"/>
			<CommandParameter Pos="11" Name="Command 11" ShowOptions="y" IsOption= "y" Default="updatesession=true" Description="Updates context for destination device"/>
			<CommandParameter Pos="12" Name="Command 12" ShowOptions="y" IsOption= "y" Default="destination=&lt;CoAP device name&gt;" Description="Name of CoAP device to activate or update"/>
		</CommentCommand> 

		<!-- Configure CoAP destination -->
		<CommentCommand Name="" Command="@@[pahdev" Category="5" Body="n" Param="y" Format="@@[pahdev&quot;&lt;destination name&gt;;basepath=&lt;base path&gt;;serialnumber=&lt;serial number&gt;;mastersecret=&lt;mastersecret&gt;;password=&lt;password&gt;;ipaddress=&lt;IP address&gt;;txseq=&lt;txseq&gt;;remove=&lt;true/false&gt;" DescrShort="Configure Point API destination" DescrLong="Destination name:&#9;&#9;Name of Point API destination to configure#basepath=&lt;&gt;&#9;&#9;device base path#serialnumber=&lt;&gt;&#9;serial number as hex value#mastersecret=&lt;&gt;&#9;master secret as hex value#password=&lt;&gt;&#9;&#9;device password as hex value#ipaddress=&lt;&gt;&#9;&#9;IP address#txseq=&lt;&gt;&#9;&#9;next TX sequence number as integer#remove=true&#9;&#9;remove security context">
			<CommandParameter Pos="0" Name="Destination name" Default="&lt;Point API destination&gt;" Description="Name of CoAP destination"/>
			<CommandParameter Pos="1" Name="Command 1" ShowOptions="y" IsOption= "y" Default="basepath=&lt;base path&gt;" Description="Set base path"/>
			<CommandParameter Pos="2" Name="Command 2" ShowOptions="y" IsOption= "y" Default="serialnumber=&lt;serial number&gt;" Description="Set serial number"/>
			<CommandParameter Pos="3" Name="Command 3" ShowOptions="y" IsOption= "y" Default="mastersecret=&lt;master secret&gt;" Description="Set master secret"/>
			<CommandParameter Pos="4" Name="Command 4" ShowOptions="y" IsOption= "y" Default="password=&lt;password&gt;" Description="Set password"/>
			<CommandParameter Pos="5" Name="Command 5" ShowOptions="y" IsOption= "y" Default="ipaddress=&lt;IP address&gt;" Description="Set IP address"/>
			<CommandParameter Pos="6" Name="Command 6" ShowOptions="y" IsOption= "y" Default="txseq=&lt;tx sequence number&gt;" Description="Change TX sequence number"/>
			<CommandParameter Pos="7" Name="Command 7" ShowOptions="y" IsOption= "y" Default="remove=&lt;true/false&gt;" Description="Remove CoAP destination (true or false)"/>
		</CommentCommand> 

		<!-- Configure CoAP multicast group -->
		<CommentCommand Name="" Command="@@[pahmcast" Category="5" Body="n" Param="y" Format="@@[pahmcast&quot;&lt;group name&gt;;groupid=&lt;group id&gt;;installationid=&lt;installation ID&gt;;scope=&lt;scope&gt;;context=&lt;RX context name&gt;;rxcontext=&lt;RX context name&gt;;txcontext=&lt;TX context name&gt;;join=&lt;true/false&gt;;remove=&lt;true/false&gt;" DescrShort="Configure CoAP multicast group" DescrLong="Group name:&#9;&#9;Name of CoAP multicast group to configure#groupid=&lt;&gt;&#9;&#9;group id as text#installationid=&lt;&gt;&#9;installationid as text#scope=&lt;&gt;&#9;&#9;sender ID as text#context=&lt;&gt;&#9;&#9;Name of RX security context#rxcontext=&lt;&gt;&#9;&#9;Name of RX security context#txcontext=&lt;&gt;&#9;&#9;Name of TX security context#join=&lt;true/false&gt;&#9;Joins or leaves multicast group#remove=true&#9;&#9;remove multicast group">
			<CommandParameter Pos="0" Name="Group name" Default="&lt;group name&gt;" Description="Name of CoAP multicast group"/>
			<CommandParameter Pos="1" Name="Command 1" ShowOptions="y" IsOption= "y" Default="groupid=&lt;group id&gt;" Description="Set group ID"/>
			<CommandParameter Pos="2" Name="Command 2" ShowOptions="y" IsOption= "y" Default="installationid=&lt;installation ID&gt;" Description="Set installation ID"/>
			<CommandParameter Pos="3" Name="Command 3" ShowOptions="y" IsOption= "y" Default="scope=&lt;scope&gt;" Description="Set scope number"/>
			<CommandParameter Pos="4" Name="Command 4" ShowOptions="y" IsOption= "y" Default="context=&lt;RX context name&gt;" Description="Set name of RX security context"/>
			<CommandParameter Pos="5" Name="Command 5" ShowOptions="y" IsOption= "y" Default="rxcontext=&lt;RX context name&gt;" Description="Set name of RX security context"/>
			<CommandParameter Pos="6" Name="Command 6" ShowOptions="y" IsOption= "y" Default="txcontext=&lt;TX context name&gt;" Description="Set name of TX security context"/>
			<CommandParameter Pos="7" Name="Command 7" ShowOptions="y" IsOption= "y" Default="join=&lt;true/false&gt;" Description="Join or leave group (true or false)"/>
			<CommandParameter Pos="8" Name="Command 8" ShowOptions="y" IsOption= "y" Default="remove=&lt;true/false&gt;" Description="Remove group (true or false)"/>
		</CommentCommand> 

		<!-- Configures automatic CoAP sequence number synchronisation -->
		<CommentCommand Name="" Command="@@[pahsnc" Category="5" Body="n" Param="y" Format="@@[pahsnc&quot;&lt;on/off&gt;&quot;" DescrShort="Switches automatic CoAP sequence number synchronisation on or off" DescrLong="">
			<CommandParameter Pos="0" Name="Switch on/off" Values="on#off" Default="&lt;on/off&gt;" Description="Automatic sequence number synchronisation on/off"/>
		</CommentCommand> 

		<!-- Configure CoAP MDNS command -->
		<CommentCommand Name="" Command="@@[pahmdns" Category="5" Body="n" Param="y" Format="@@[pahmdns&quot;rqcheck=&lt;on/off&gt;&quot;" DescrShort="Check if the answered service is equal to the requested service" DescrLong="">
			<CommandParameter Pos="0" Name="Service check" Values="rqcheck=on#rqcheck=off" Default="&lt;rqcheck=on/off&gt;" Description="Check for requested service on/off"/>
		</CommentCommand> 

		<!-- Point API device discovery -->
		<CommentCommand Name="" Command="@@[pahdiscover" Category="5" Body="n" Param="n" Format="@@[pahdiscover" DescrShort="Performs Point API device discovery" DescrLong=""/>

		<!-- ======================= 3RD PARTY API ======================= -->
		
    </CommentCommands>
</EITT_KnxCommentCommandDescriptions>
