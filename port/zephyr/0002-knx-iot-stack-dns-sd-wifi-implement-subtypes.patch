     oc_device_info_t *device = oc_core_get_device_info();
@@ -162,12 +209,24 @@ int knx_publish_service(char *serial_no, uint64_t iid, uint16_t ia, bool pm)
     PRINT("KNX mDNS service registered: %s._knx._udp.local port %d\r\n",
           knx_instance, knx_port);
 
-    /* TODO: register DNS-SD subtypes:
