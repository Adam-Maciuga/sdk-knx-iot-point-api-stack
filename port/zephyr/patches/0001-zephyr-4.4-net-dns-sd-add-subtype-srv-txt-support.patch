+	uint16_t inst_offs;
+	uint16_t dom_offs;
+	size_t subtype_len;
+	size_t label_size;
+	uint16_t sp_size;
+	int name_size;
+	struct dns_rr *rr;
+	uint16_t svc_ptr;
+	const char *svc_labels[3];
