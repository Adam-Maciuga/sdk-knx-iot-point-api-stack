+			      + DNS_LABEL_LEN_SIZE + 4U);  /* after <subtype> + _sub */
+	if ((svc_offs & DNS_SD_PTR_MASK) != 0) {
+		NET_DBG("svc offset %u too big for message compression", svc_offs);
+		return -E2BIG;
+	}
