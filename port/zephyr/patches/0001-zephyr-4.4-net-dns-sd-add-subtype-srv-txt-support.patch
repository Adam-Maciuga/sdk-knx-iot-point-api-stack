+ * @param instance_offset [out] absolute offset of <instance> in the RDATA
+ * @param domain_offset  [out] absolute offset of <domain>. label in @p buf
+ *
+ * @return bytes written on success, negative errno on failure
+ */
+static int add_subtype_ptr_record(const struct dns_sd_rec *inst, uint32_t ttl,
