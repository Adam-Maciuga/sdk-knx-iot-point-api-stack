+	rr = (struct dns_rr *)&buf[offset];
+	rr->type = net_htons(DNS_RR_TYPE_PTR);
+	rr->class_ = net_htons(DNS_CLASS_IN);
+	rr->ttl = net_htonl(ttl);
+	rr->rdlength = net_htons((uint16_t)(DNS_LABEL_LEN_SIZE
