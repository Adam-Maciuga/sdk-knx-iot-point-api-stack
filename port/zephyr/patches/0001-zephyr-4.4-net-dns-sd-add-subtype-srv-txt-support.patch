+	/*
+	 * RFC 6763 §12.2 — response to a TXT query for a specific instance:
+	 *   Answer:     TXT record
+	 *   Additional: none required
+	 */
+	uint16_t instance_offset;
+	uint16_t service_offset;
+	uint16_t domain_offset;
+	uint16_t offset = sizeof(struct dns_header);
+	struct dns_header *rsp = (struct dns_header *)buf;
+	int r;
+
+	ARG_UNUSED(iface);
+
+	memset(rsp, 0, sizeof(*rsp));
+
+	if (!rec_is_valid(inst)) {
+		return -EINVAL;
+	}
+
+	if (*(inst->port) == 0) {
+		NET_DBG("Ephemeral port for %s.%s.%s.%s not initialised",
+			inst->instance, inst->service, inst->proto, inst->domain);
+		return -EHOSTDOWN;
+	}
+
+	/*
+	 * Use a PTR record prefix so that add_txt_record can write a
+	 * compression pointer back to the instance name.
+	 */
+	r = add_ptr_record(inst, DNS_SD_PTR_TTL, buf, offset, buf_size,
+			   &service_offset, &instance_offset, &domain_offset);
+	if (r < 0) {
+		return r; /* LCOV_EXCL_LINE */
+	}
+
+	rsp->ancount++;
+	offset += r;
+
+	r = add_txt_record(inst, DNS_SD_TXT_TTL, instance_offset,
+			   buf, offset, buf_size);
+	if (r < 0) {
+		return r; /* LCOV_EXCL_LINE */
+	}
+
+	rsp->ancount++;
+	offset += r;
+
+	/* Set the Response and AA bits */
+	rsp->flags = net_htons(BIT(15) | BIT(10));
+	rsp->ancount = net_htons(rsp->ancount);
+	rsp->arcount = net_htons(rsp->arcount);
+
+	return offset;
