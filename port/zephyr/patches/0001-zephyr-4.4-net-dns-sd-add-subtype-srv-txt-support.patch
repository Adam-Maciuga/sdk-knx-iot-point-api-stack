+	/*
+	 * Total record size:
+	 *   owner name: (1+subtype_len) + (1+4="_sub") + sp_size
+	 *   RR header:  sizeof(dns_rr)
+	 *   rdata:      (1+strlen(instance)) + DNS_POINTER_SIZE
