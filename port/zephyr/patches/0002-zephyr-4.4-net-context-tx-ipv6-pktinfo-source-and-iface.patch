From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Burker <burker@ucs.at>
Date: Thu, 25 Jun 2026 12:00:00 +0200
Subject: [PATCH] net: context: honour IPV6_PKTINFO source and interface on send

The Zephyr send path ignores the IPV6_PKTINFO ancillary data on TX, so an
application cannot pin the source address or the outgoing interface of a UDP
datagram. The source comes from the bound local address, otherwise from the
default selection in net_if_ipv6_select_src_addr_hint().

Add a helper that returns the IPV6_PKTINFO carried by a send call and use it to:
- pass its source address (ipi6_addr) to net_context_create_ipv6_new() so an
  explicit, non-unspecified source is used, and
- select the egress interface from its ipi6_ifindex in context_sendto(), ahead
  of the destination-based selection and only when the interface was not already
  chosen by the multicast or link-local logic.

The change is inert when no IPV6_PKTINFO send cmsg is present. This mirrors the
IPV6_PKTINFO send behaviour of Linux and BSD sockets and lets the KNX-IoT Wi-Fi
port reply from the address a request was sent to and, on multi-interface
boards, on the interface it arrived on.
---
 subsys/net/ip/net_context.c | 54 ++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 53 insertions(+), 1 deletion(-)

diff --git a/subsys/net/ip/net_context.c b/subsys/net/ip/net_context.c
index a70e11a0a4a..1f10277770e 100644
--- a/subsys/net/ip/net_context.c
+++ b/subsys/net/ip/net_context.c
@@ -2160,6 +2160,33 @@ static int context_write_data(struct net_pkt *pkt, const void *buf,
 	return ret;
 }

+/* Return the IPV6_PKTINFO ancillary data supplied by the application on a send
+ * call, or NULL when none is present. The returned pktinfo carries an optional
+ * source address (ipi6_addr) and outgoing interface index (ipi6_ifindex), which
+ * let the caller pin the source address and egress interface of the outgoing
+ * datagram instead of running the default selection. This mirrors the
+ * IPV6_PKTINFO send behaviour of Linux and BSD sockets.
+ */
+static const struct net_in6_pktinfo *get_tx_pktinfo6(const struct net_msghdr *msg)
+{
+	struct net_cmsghdr *cmsg;
+
+	if (msg == NULL || msg->msg_control == NULL || msg->msg_controllen == 0) {
+		return NULL;
+	}
+
+	for (cmsg = NET_CMSG_FIRSTHDR(msg); cmsg != NULL;
+	     cmsg = NET_CMSG_NXTHDR(msg, cmsg)) {
+		if (cmsg->cmsg_len == NET_CMSG_LEN(sizeof(struct net_in6_pktinfo)) &&
+		    cmsg->cmsg_level == NET_IPPROTO_IPV6 &&
+		    cmsg->cmsg_type == ZSOCK_IPV6_PKTINFO) {
+			return (struct net_in6_pktinfo *)NET_CMSG_DATA(cmsg);
+		}
+	}
+
+	return NULL;
+}
+
 static int context_setup_udp_packet(struct net_context *context,
 				    net_sa_family_t family,
 				    struct net_pkt *pkt,
@@ -2174,11 +2201,20 @@ static int context_setup_udp_packet(struct net_context *context,

 	if (IS_ENABLED(CONFIG_NET_IPV6) && family == NET_AF_INET6) {
 		struct net_sockaddr_in6 *addr6 = (struct net_sockaddr_in6 *)dst_addr;
+		const struct net_in6_pktinfo *pktinfo = get_tx_pktinfo6(msg);
+		const struct net_in6_addr *src6 = NULL;
+
+		/* Use the application-supplied source address unless it is the
+		 * unspecified address, in which case the default selection applies.
+		 */
+		if (pktinfo != NULL && !net_ipv6_is_addr_unspecified(&pktinfo->ipi6_addr)) {
+			src6 = &pktinfo->ipi6_addr;
+		}

 		dst_port = addr6->sin6_port;

 		ret = net_context_create_ipv6_new(context, pkt,
-						  NULL, &addr6->sin6_addr);
+						  src6, &addr6->sin6_addr);
 	} else if (IS_ENABLED(CONFIG_NET_IPV4) && family == NET_AF_INET) {
 		struct net_sockaddr_in *addr4 = (struct net_sockaddr_in *)dst_addr;

@@ -2496,6 +2532,22 @@ static int context_sendto(struct net_context *context,
 			}
 		}

+		/* An explicit outgoing interface supplied through IPV6_PKTINFO takes
+		 * precedence over the destination-based interface selection below. This
+		 * is required on multi-interface boards (e.g. Ethernet plus Wi-Fi) so a
+		 * reply leaves on the interface the request arrived on.
+		 */
+		if (iface == NULL && msghdr != NULL) {
+			const struct net_in6_pktinfo *pktinfo = get_tx_pktinfo6(msghdr);
+
+			if (pktinfo != NULL && pktinfo->ipi6_ifindex > 0) {
+				iface = net_if_get_by_index(pktinfo->ipi6_ifindex);
+				if (iface != NULL) {
+					net_context_set_iface(context, iface);
+				}
+			}
+		}
+
 		/* If application has not yet set the destination address
 		 * i.e., by not calling connect(), then set the interface
 		 * here so that the packet gets sent to the correct network
--
2.53.0
