From 0000000000000000000000000000000000000005 Mon Sep 17 00:00:00 2001
From: Alexander Burker <burker@ucs.at>
Date: Tue, 08 Apr 2026 00:00:00 +0000
Subject: [PATCH 5/5] lib: libc: common: Add malloc heap stats accessor functions

Add two functions that expose the C library malloc heap statistics when
CONFIG_SYS_HEAP_RUNTIME_STATS is enabled:

  int z_malloc_heap_runtime_stats_get(struct sys_memory_stats *stats)
  size_t z_malloc_heap_init_bytes(void)

These mirror the existing pattern of sys_heap_runtime_stats_get() used
for the Zephyr sys_heap (_system_heap), but applied to z_malloc_heap,
which is otherwise inaccessible because it is declared static.

Signed-off-by: Alexander Burker <burker@ucs.at>
---
 lib/libc/common/source/stdlib/malloc.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/lib/libc/common/source/stdlib/malloc.c b/lib/libc/common/source/stdlib/malloc.c
--- a/lib/libc/common/source/stdlib/malloc.c
+++ b/lib/libc/common/source/stdlib/malloc.c
@@ -261,5 +261,27 @@ void free(void *ptr)
 	sys_heap_free(&z_malloc_heap, ptr);
 	malloc_unlock();
 }
 
+#ifdef CONFIG_SYS_HEAP_RUNTIME_STATS
+/**
+ * @brief Get runtime statistics for the C library malloc heap.
+ *
+ * Provides the same information as sys_heap_runtime_stats_get() but for
+ * z_malloc_heap, which is not directly accessible from outside this
+ * translation unit because it is declared static.
+ *
+ * @param stats Pointer to a sys_memory_stats struct to fill in.
+ * @return 0 on success, negative error code on failure.
+ */
+int z_malloc_heap_runtime_stats_get(struct sys_memory_stats *stats)
+{
+	return sys_heap_runtime_stats_get(&z_malloc_heap, stats);
+}
+
+size_t z_malloc_heap_init_bytes(void)
+{
+	return z_malloc_heap.init_bytes;
+}
+#endif
+
 SYS_INIT(malloc_prepare, POST_KERNEL, CONFIG_KERNEL_INIT_PRIORITY_LIBC);
